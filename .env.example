# Local dev settings: cp .env.example .env && docker compose up --build
# Placeholder / demo values only.

# so docker compose works from the repo root
COMPOSE_FILE=deploy/docker-compose.yml:deploy/docker-compose.override.yml

# HS256 key shared by all services (32+ chars)
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef

POSTGRES_USER=parcel
POSTGRES_PASSWORD=parcel

# local demo accounts only (Development seeder + courier simulator)
SEED_DEMO_PASSWORD=Demo@12345

# courier simulator
GATEWAY_URL=http://localhost:8080
