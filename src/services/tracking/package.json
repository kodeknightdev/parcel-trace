{
  "name": "parcel-trace-tracking",
  "version": "1.0.0",
  "private": true,
  "description": "parcel-trace tracking service: courier pings, latest positions and the shipment status timeline",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11 <21"
  },
  "scripts": {
    "start": "node -r ./src/tracing.js src/server.js",
    "dev": "node --watch -r ./src/tracing.js src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "node src/rebuild.js"
  },
  "dependencies": {
    "@fastify/jwt": "8.0.0",
    "@fastify/swagger": "8.14.0",
    "@fastify/swagger-ui": "3.0.0",
    "@opentelemetry/api": "1.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.50.0",
    "@opentelemetry/instrumentation-fastify": "0.35.0",
    "@opentelemetry/instrumentation-http": "0.50.0",
    "@opentelemetry/instrumentation-ioredis": "0.39.0",
    "@opentelemetry/instrumentation-pg": "0.40.0",
    "@opentelemetry/sdk-node": "0.50.0",
    "fastify": "4.26.2",
    "fastify-plugin": "4.5.1",
    "ioredis": "5.4.1",
    "kafkajs": "2.2.4",
    "opossum": "8.1.3",
    "pg": "8.11.5"
  },
  "devDependencies": {
    "vitest": "1.5.0"
  }
}
