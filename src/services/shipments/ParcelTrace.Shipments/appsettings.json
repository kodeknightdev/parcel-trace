{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5102",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5112",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "Shipments": "Host=localhost;Port=5432;Database=shipments;Username=parcel;Password=parcel"
  },
  "Jwt": {
    "Issuer": "parcel-trace-identity",
    "Audience": "parcel-trace",
    "SigningKey": ""
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9094",
    "GroupId": "shipments",
    "MaxRetries": 5
  },
  "Services": {
    "Eta": "http://localhost:5105"
  },
  "Shipments": {
    "CancelWindowMinutes": 30,
    "StandardSlaHours": 48,
    "ExpressSlaHours": 8
  },
  "Outbox": {
    "PollIntervalMs": 1000,
    "BatchSize": 50
  },
  "Database": {
    "MigrateOnStartup": false,
    "Seed": true
  }
}
