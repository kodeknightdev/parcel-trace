{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "parcel-trace-identity",
    "Audience": "parcel-trace",
    "SigningKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [
            "POST"
          ]
        },
        "Order": 0
      },
      "auth-register": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/register",
          "Methods": [
            "POST"
          ]
        },
        "Order": 0
      },
      "auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "users": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/users/{**rest}"
        }
      },
      "shipments-quote": {
        "ClusterId": "shipments",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/shipments/quote",
          "Methods": [
            "POST"
          ]
        },
        "Order": 0
      },
      "shipments-track": {
        "ClusterId": "shipments",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/shipments/track/{trackingNumber}",
          "Methods": [
            "GET"
          ]
        },
        "Order": 0
      },
      "shipments": {
        "ClusterId": "shipments",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/shipments/{**rest}"
        }
      },
      "couriers": {
        "ClusterId": "dispatch",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/couriers/{**rest}"
        }
      },
      "dispatch": {
        "ClusterId": "dispatch",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/dispatch/{**rest}"
        }
      },
      "tracking-public": {
        "ClusterId": "tracking",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/tracking/{trackingNumber}",
          "Methods": [
            "GET"
          ]
        },
        "Order": 0
      },
      "tracking": {
        "ClusterId": "tracking",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/tracking/{**rest}"
        }
      },
      "eta": {
        "ClusterId": "eta",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/eta/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "shipments": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "dispatch": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "tracking": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "eta": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105"
          }
        }
      }
    }
  }
}
