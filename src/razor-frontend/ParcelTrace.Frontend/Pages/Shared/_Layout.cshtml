<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · parcel-trace</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand fw-semibold" asp-page="/Index"><i class="bi bi-box-seam"></i> parcel-trace</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-page="/Track">Track</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Quote">Get a quote</a></li>
                @if (User.IsInRole(Roles.Customer) || User.IsInRole(Roles.Admin))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Shipments/Index">My shipments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Shipments/Create">Send a parcel</a></li>
                }
                @if (User.IsInRole(Roles.Dispatcher) || User.IsInRole(Roles.Admin))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Dispatch/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Dispatch/Couriers">Couriers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Dispatch/Route">Routes</a></li>
                }
                @if (User.IsInRole(Roles.Courier))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Courier/Index">My route</a></li>
                }
                @if (User.IsInRole(Roles.Admin))
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Admin/Users">Users</a></li>
                }
            </ul>
            <ul class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><span class="navbar-text me-3"><i class="bi bi-person-circle"></i> @User.Identity.Name <span class="badge text-bg-secondary">@User.FindFirst(ParcelClaims.Role)?.Value</span></span></li>
                    <li class="nav-item">
                        <form method="post" asp-page="/Account/Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm mt-1">Sign out</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Sign in</a></li>
                    <li class="nav-item"><a class="btn btn-primary btn-sm mt-1 ms-md-2" asp-page="/Account/Register">Create account</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

<main class="container pb-5">
    @if (TempData["Flash"] is string flash)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @flash
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["FlashError"] is string flashError)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @flashError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @RenderBody()
</main>

<footer class="border-top py-3 text-muted small">
    <div class="container d-flex justify-content-between">
        <span>parcel-trace &middot; courier tracking &amp; dispatch</span>
        <span>Map data &copy; OpenStreetMap contributors</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
