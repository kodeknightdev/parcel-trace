@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-3">Sign in</h1>
        <form method="post" class="card card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Email"></label>
                <input class="form-control" asp-for="Input.Email" autocomplete="username" />
                <span class="text-danger small" asp-validation-for="Input.Email"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Input.Password"></label>
                <input class="form-control" asp-for="Input.Password" autocomplete="current-password" />
                <span class="text-danger small" asp-validation-for="Input.Password"></span>
            </div>
            <button class="btn btn-primary w-100" type="submit">Sign in</button>
        </form>
        <p class="mt-3 small">No account yet? <a asp-page="Register">Create one</a>.</p>
        <details class="small text-muted">
            <summary>Local demo accounts</summary>
            <p class="mb-1 mt-2">Created by the Development seeder only. Password: the <code>SEED_DEMO_PASSWORD</code> value from <code>.env</code> (<code>Demo@12345</code> in <code>.env.example</code>).</p>
            <ul class="mb-0">
                <li>Customer: customer@parceltrace.local</li>
                <li>Dispatcher: dispatcher@parceltrace.local</li>
                <li>Courier: courier1@parceltrace.local</li>
                <li>Admin: admin@parceltrace.local</li>
            </ul>
        </details>
    </div>
</div>
