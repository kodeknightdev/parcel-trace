# copy to terraform.tfvars, placeholders only
subscription_id         = "00000000-0000-0000-0000-000000000000"
environment             = "prod"
location                = "westeurope"
kubernetes_version      = "1.29"
mongo_connection_string = "mongodb+srv://<user>:<password>@<cluster>.example.net/dispatch"
redis_connection_string = "rediss://:<access-key>@<name>.redis.cache.windows.net:6380"
